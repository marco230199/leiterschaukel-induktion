# Abgabe-Server als Systemdienst (wird von einrichten.sh nach /etc/systemd/system/ kopiert)
[Unit]
Description=Leiterschaukel – Abgabe-Server
After=network.target

[Service]
EnvironmentFile=/etc/leiterschaukel-abgabe.env
ExecStart=/usr/bin/node /opt/leiterschaukel/server/server.js
Restart=always
RestartSec=2
# eigener, unprivilegierter Benutzer; darf nirgends schreiben (Abgaben liegen nur im Arbeitsspeicher)
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
MemoryMax=400M

[Install]
WantedBy=multi-user.target
